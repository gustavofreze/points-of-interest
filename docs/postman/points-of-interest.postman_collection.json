		{
			"name": "Queries",
			"item": [
				{
					"name": "Find points of interest",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Answers a cursor page carrying the point just registered', function () {",
									"    pm.response.to.have.status(200);",
									"    const body = pm.response.json();",
									"    pm.expect(body.data).to.be.an('array');",
									"    pm.expect(body.meta).to.have.property('has_next');",
									"    pm.expect(body.links.self).to.be.a('string');",
									"    pm.expect(body.data.map(point => point.id)).to.include(",
									"        pm.collectionVariables.get('pointOfInterestId')",
									"    );",
									"});",
									"",
									"pm.test('Carries the RFC 8288 navigation header', function () {",
									"    pm.expect(pm.response.headers.get('Link')).to.include('rel=\"self\"');",
									"});"
								]
							}
						}
					],
