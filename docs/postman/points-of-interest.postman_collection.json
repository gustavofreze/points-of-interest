		{
			"name": "Use cases",
			"item": [
				{
					"name": "Register a point of interest",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// The name and the coordinates are unique together, so a fixed body would answer 409",
									"// on the second run against the same stack. A name built per run keeps the collection",
									"// repeatable without ever dropping the schema.",
									"const pointName = `Mirante ${Date.now()}`;",
									"",
									"pm.collectionVariables.set('pointName', pointName);",
									"",
									"if (pm.environment.name) {",
									"    pm.environment.set('pointName', pointName);",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Records the point of interest and assigns it an identifier', function () {",
									"    pm.response.to.have.status(201);",
									"    const body = pm.response.json();",
									"    pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
									"});",
									"",
									"// The queries below read this point back. A selected environment shadows the collection",
									"// scope, so writing only the collection variable would leave a stale environment entry winning.",
									"const pointOfInterestId = pm.response.json().id;",
									"",
									"pm.collectionVariables.set('pointOfInterestId', pointOfInterestId);",
									"",
									"if (pm.environment.name) {",
									"    pm.environment.set('pointOfInterestId', pointOfInterestId);",
									"}"
								]
							}
						}
					],
