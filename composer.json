{
    "name": "gustavofreze/points-of-interest",
    "description": "Service responsible for registering points of interest and finding those near a reference coordinate.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "backend-br",
        "points-of-interest"
    ],
    "authors": [
        {
            "name": "Gustavo Freze de Araujo Santos",
            "homepage": "https://github.com/gustavofreze"
        }
    ],
    "homepage": "https://github.com/gustavofreze/points-of-interest",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4",
        "php-di/slim-bridge": "^3.4",
        "ramsey/uuid": "^4.9",
        "respect/validation": "^3.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "tiny-blocks/building-blocks": "^5.3",
        "tiny-blocks/environment-variable": "^2.0",
        "tiny-blocks/http": "^7.2",
        "tiny-blocks/http-error-handler": "^2.0",
        "tiny-blocks/http-health-check": "^1.1",
        "tiny-blocks/http-logging": "^1.2",
        "tiny-blocks/http-query": "^2.4",
        "tiny-blocks/logger": "^4.0",
        "tiny-blocks/mapper": "^3.2",
        "tiny-blocks/outbox": "^5.1",
        "tiny-blocks/value-object": "^5.0"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.11",
        "ergebnis/composer-normalize": "^2.53",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0",
        "tiny-blocks/docker-container": "^3.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "PointsOfInterest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "configure": [
            "@composer install --optimize-autoloader",
            "@composer normalize"
        ],
        "configure-and-update": [
            "@composer update --optimize-autoloader",
            "@composer normalize"
        ],
        "fix-review": "php ./vendor/bin/phpcbf --standard=phpcs.xml --extensions=php ./src ./tests",
        "review": [
            "php ./vendor/bin/phpcs --standard=phpcs.xml --extensions=php --ignore=src/Dependencies.php ./src ./tests",
            "php ./vendor/bin/phpstan analyse --quiet --no-progress"
        ],
        "test-file": "RUN_MIGRATIONS=1 php ./vendor/bin/phpunit --configuration phpunit.xml --no-coverage --filter",
        "tests": [
            "RUN_MIGRATIONS=1 php -d memory_limit=2G ./vendor/bin/phpunit --configuration phpunit.xml tests",
            "php ./vendor/bin/infection --threads=max --logger-html=reports/coverage/mutation-report.html --coverage=reports/coverage"
        ]
    }
}
