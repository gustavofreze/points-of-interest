{
    "name": "gustavofreze/points-of-interest",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/gustavofreze/points-of-interest",
    "description": "Implementação do desafio 'Pontos de Interesse por GPS', do repositório backend-br.",
    "prefer-stable": true,
    "minimum-stability": "stable",
    "keywords": [
        "backend-br",
        "points-of-interest"
    ],
    "authors": [
        {
            "name": "Gustavo Freze de Araujo Santos",
            "homepage": "https://github.com/gustavofreze"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "PointsOfInterest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PointsOfInterest\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "doctrine/dbal": "^3.9",
        "respect/validation": "^2.4",
        "php-di/slim-bridge": "^3.4",
        "tiny-blocks/http": "^4.2",
        "tiny-blocks/mapper": "^1.4",
        "tiny-blocks/collection": "^1.14",
        "tiny-blocks/value-object": "^3.2",
        "tiny-blocks/environment-variable": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.32",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "test": "php -d memory_limit=2G ./vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpcs": "php ./vendor/bin/phpcs --standard=PSR12 --extensions=php ./src",
        "phpstan": "php ./vendor/bin/phpstan analyse -c phpstan.neon.dist --quiet --no-progress",
        "mutation-test": "php ./vendor/bin/infection --threads=max --logger-html=report/coverage/mutation-report.html --coverage=report/coverage",
        "review": [
            "@phpcs",
            "@phpstan"
        ],
        "tests": [
            "@test",
            "@mutation-test"
        ]
    }
}
